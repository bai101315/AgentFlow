# AgentFlow local runtime
AGENTFLOW_HOME=./.agentflow
DEER_FLOW_CONFIG_PATH=./config.yaml
DEER_FLOW_EXTENSIONS_CONFIG_PATH=./extensions_config.json

# Model providers
DASHSCOPE_API_KEY=your-dashscope-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
MINIMAX_API_KEY=your-minimax-api-key
DOUBAO_API_KEY=your-doubao-api-key

# Web/search tools
TAVILY_API_KEY=your-tavily-api-key
JINA_API_KEY=your-jina-api-key

# MCP tools
GITHUB_TOKEN=your-github-token
LEETCODE_SESSION=your-leetcode-session

# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=agentflow
